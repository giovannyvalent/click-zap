NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor; nunca use prefixo NEXT_PUBLIC nesta chave
SUPABASE_SERVICE_ROLE_KEY=
# Gere com: openssl rand -hex 32 (hash de IP para limite de requisições)
RATE_LIMIT_SECRET=
# Somente servidor; chave da API do Asaas (sandbox ou produção)
ASAAS_API_KEY=
# "sandbox" ou "production" — define a URL base da API do Asaas
ASAAS_ENV=sandbox
# Gere com: openssl rand -hex 32 — cole o mesmo valor no campo "Token de autenticação" do webhook, no painel do Asaas
ASAAS_WEBHOOK_TOKEN=
